---
import { Icon } from "astro-icon/components";

/* ─────────────────────────────────────────────
   Intent: Render a single testimonial quote with
   attribution. Used inside ProjectLayout (per-
   project) and TestimonialsSection (homepage).

   Design (design-direction.md, 2026-10-22): a
   quiet card in the CRM panel language —
   border-border on bg-card, shadow-sm, a neutral
   left rule and muted quote marks. Hover is
   border feedback only; no lift, no glow.

   If photo is omitted, a monogram fallback
   (initials) is shown instead.

   The "compact" variant reduces padding for
   grid contexts (homepage).
   ───────────────────────────────────────────── */

type Props = {
  quote: string;
  author: string;
  role: string;
  company?: string;
  photo?: string;
  linkedin?: string;
  /** Slightly tighter padding for homepage grid context */
  variant?: "default" | "compact";
};

const {
  quote,
  author,
  role,
  company,
  photo,
  linkedin,
  variant = "default",
} = Astro.props as Props;

const isCompact = variant === "compact";

// Initials fallback
const initials = author
  .split(" ")
  .map((n) => n[0])
  .join("")
  .toUpperCase()
  .slice(0, 2);
---

<div
  class={`relative rounded-xl border border-border bg-card shadow-sm transition-colors duration-300 hover:border-brand/40 ${
    isCompact ? "p-6" : "p-6 md:p-8"
  }`}
>
  {/* Left rule */}
  <div
    class="absolute top-4 bottom-4 left-0 w-[5px] rounded-r-full bg-border"
  >
  </div>

  {/* Quote with inline marks */}
  <div class="ml-2">
    <blockquote
      class={`relative font-medium leading-relaxed text-foreground ${
        isCompact ? "text-sm" : "text-[15px] md:text-[17px] md:leading-8"
      }`}
    >
      <span
        class="absolute -top-1 -left-4 text-2xl leading-none text-muted-foreground/40 select-none"
        aria-hidden="true">&ldquo;</span
      >
      {quote}
      <span
        class="align-bottom text-2xl leading-none text-muted-foreground/40 select-none"
        aria-hidden="true">&rdquo;</span
      >
    </blockquote>
  </div>

  {/* Divider with dot */}
  <div
    class={`relative ml-2 flex items-center gap-3 ${isCompact ? "mt-5" : "mt-6"}`}
  >
    <div class="h-px flex-1 bg-border"></div>
    <div class="size-1.5 rounded-full bg-muted-foreground/40"></div>
    <div class="h-px flex-1 bg-border"></div>
  </div>

  {/* Author attribution */}
  <div class={`ml-2 flex items-center gap-4 ${isCompact ? "mt-4" : "mt-5"}`}>
    {/* Photo or initials monogram */}
    {
      photo ? (
        <img
          src={photo}
          alt={author}
          class={`shrink-0 rounded-full object-cover shadow-sm ring-1 ring-border ${
            isCompact ? "size-11" : "size-12 md:size-14"
          }`}
          loading="lazy"
        />
      ) : (
        <div
          class={`flex shrink-0 items-center justify-center rounded-full bg-secondary font-bold text-foreground ring-1 ring-border ${
            isCompact ? "size-11 text-xs" : "size-12 text-sm md:size-14"
          }`}
        >
          {initials}
        </div>
      )
    }

    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2">
        <span
          class={`font-bold text-foreground ${isCompact ? "text-sm" : "text-sm md:text-base"}`}
        >
          {author}
        </span>
        {
          linkedin && (
            <a
              href={linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex size-6 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-brand-soft hover:text-brand"
              title={`${author} on LinkedIn`}
            >
              <Icon name="mdi:linkedin" class="size-3.5" />
            </a>
          )
        }
      </div>
      <p
        class={`leading-tight text-muted-foreground ${isCompact ? "text-xs" : "text-xs md:text-sm"}`}
      >
        {role}
        {
          company && (
            <>
              <span class="mx-1.5 text-muted-foreground/40">&middot;</span>
              <span class="font-semibold text-foreground">{company}</span>
            </>
          )
        }
      </p>
    </div>
  </div>
</div>
