---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

/* Service row (design-direction.md, 2026-10-22): the gradient icon tile and
   the stock illustration are gone. Left = what the step is; right = the
   deliverable you walk away with, in a card that looks like the CRM's
   panels. The green marks the deliverables — proof marks. */

export type Service = {
  /** Mono step marker, e.g. "01" */
  num: string;
  title: string;
  description: string;
  walkaway: readonly string[];
};

const t = useTranslations(getLangFromUrl(Astro.url));

const { service, walkawayLabel } = Astro.props as {
  service: Service;
  walkawayLabel: string;
};
---

<div class="grid gap-10 md:grid-cols-2 md:items-start md:gap-16">
  {/* ─── Left: the step ─── */}
  <div>
    <p class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase">
      {t("services.step.label")} {service.num}
    </p>
    <h3 class="mt-2 text-2xl font-bold sm:text-3xl">{service.title}</h3>
    <p
      class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg"
    >
      {service.description}
    </p>
  </div>

  {/* ─── Right: the deliverable ─── */}
  <div class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-7">
    <p class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase">
      {walkawayLabel}
    </p>
    <ul class="mt-4 space-y-3">
      {
        service.walkaway.map((item) => (
          <li class="flex items-start gap-2.5">
            <Icon
              name="mdi:check-circle"
              class="mt-0.5 size-4.5 shrink-0 text-brand"
            />
            <span class="text-base leading-relaxed text-foreground">
              {item}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
