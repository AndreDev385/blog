---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import ChapterHeading from "./ChapterHeading.astro";
import ProjectCard from "./ProjectCard.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Get projects for the current language, sorted by order
const allProjects = (await getCollection("projects"))
  .filter((p) => p.id.startsWith(`${lang}/`))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---

<section class="bg-secondary/40 px-6 py-20 md:px-4 md:py-28">
  <div class="mx-auto max-w-4xl">
    <div class="mb-12" data-reveal>
      <ChapterHeading
        chapter={{ key: "projects", title: t("projects.title") }}
        size="lg"
      />
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        {t("projects.subtitle")}
      </p>
    </div>
    <div class="space-y-8">
      {
        allProjects.map((project, index) => (
          <div data-reveal style={`transition-delay: ${index * 100}ms`}>
            <ProjectCard project={project} />
          </div>
        ))
      }
    </div>
  </div>
</section>
