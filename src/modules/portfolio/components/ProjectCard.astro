---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import BruschiRentalsLogo from "@/assets/bruschi_rentals.svg";
import BrDashboard1 from "@/assets/br_dashboard1.png";
import BrDashboard2 from "@/assets/br_dashboard2.png";
import BrDashboard3 from "@/assets/br_dashboard3.png";
import AdcendiaLogo from "@/assets/adcendia_logo2.jpeg";
import GamemindIcon from "@/assets/gamemind_icon.png";

/* ─────────────────────────────────────────────
   Intent: A project case study card for the
   portfolio index page. It needs to hook a
   visitor into clicking through to the full case
   study. The card is the transition from "what
   they built" → "the full story".

   On mobile it should be compact — small
   padding, truncated description — and still
   communicate impact. On desktop it breathes.

   Palette (design-direction.md, 2026-10-22):
   grayscale ground + one green accent. Green is
   earned by the CTA and hover feedback only —
   no gradient glows, no floating circles.
   ───────────────────────────────────────────── */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Project = CollectionEntry<"projects">;

const { project } = Astro.props as { project: Project };

const logoMap: Record<string, ImageMetadata> = {
  "bruschi_rentals.svg": BruschiRentalsLogo,
  "adcendia_logo2.jpeg": AdcendiaLogo,
  "gamemind_icon.png": GamemindIcon,
};

const projectLogo = project.data.logo
  ? logoMap[project.data.logo.split("/").pop() || ""]
  : undefined;

// ── Image lookup for screenshot preview ──
const imageLookup: Record<string, ImageMetadata> = {
  "br_dashboard1.png": BrDashboard1,
  "br_dashboard2.png": BrDashboard2,
  "br_dashboard3.png": BrDashboard3,
};

function resolveProjectImage(imgPath: string): ImageMetadata | undefined {
  const filename = imgPath.split("/").pop() || "";
  return imageLookup[filename];
}

const previewScreenshot = project.data.images?.[0]
  ? resolveProjectImage(project.data.images[0])
  : undefined;

const detailUrl = `/${lang}/projects/${project.id.split("/").pop()}`;
---

<div
  class="group rounded-2xl border border-border bg-card shadow-sm transition-colors duration-300 hover:border-brand/40"
>
  <div class="flex flex-col gap-4 p-5 md:gap-6 md:p-8">
    {/* ─── Header: Logo + Badge + External Link ─── */}
    <div class="flex items-start gap-3 md:gap-4">
      {/* Logo */}
      {
        projectLogo ? (
          <Image
            src={projectLogo}
            width={48}
            height={48}
            alt={`${project.data.title} logo`}
            class="size-10 flex-shrink-0 rounded-xl object-contain ring-1 ring-border md:size-14"
          />
        ) : (
          <div class="flex size-10 flex-shrink-0 items-center justify-center rounded-xl bg-secondary md:size-14">
            <Icon
              name="mdi:package"
              class="size-6 text-muted-foreground md:size-8"
            />
          </div>
        )
      }

      <div class="min-w-0 flex-1">
        <span
          class="inline-block rounded-full border border-border bg-secondary/50 px-2.5 py-0.5 font-mono text-[10px] tracking-[0.14em] text-muted-foreground uppercase md:text-xs"
        >
          {lang === "es" ? "Caso de Estudio" : "Case Study"}
        </span>
        <h2
          class="mt-2 text-xl font-bold text-foreground transition-colors duration-300 group-hover:text-brand md:text-2xl"
        >
          {project.data.title}
        </h2>
      </div>

      {/* External link */}
      {
        project.data.link && (
          <a
            href={project.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex flex-shrink-0 items-center rounded-lg p-1.5 text-muted-foreground transition-colors duration-200 hover:bg-secondary hover:text-brand md:p-2"
            title={`Visit ${project.data.title}`}
            aria-label="Visit web site"
          >
            <Icon name="mdi:open-in-new" class="size-4 md:size-5" />
          </a>
        )
      }
    </div>

    {/* ─── Description — condensed on mobile ─── */}
    <p
      class="line-clamp-3 text-sm leading-relaxed text-muted-foreground md:line-clamp-none md:text-base"
    >
      {project.data.description}
    </p>

    {/* ─── Problem Teaser ─── */}
    {
      project.data.problem && (
        <div class="rounded-xl border border-border bg-secondary/40 p-3 md:p-4">
          <div class="mb-1 flex items-center gap-2">
            <div class="flex size-5 items-center justify-center rounded-full border border-border bg-card md:size-6">
              <Icon
                name="mdi:alert-circle-outline"
                class="size-3 text-muted-foreground md:size-3.5"
              />
            </div>
            <span
              class="font-mono text-[10px] tracking-[0.14em] text-muted-foreground uppercase md:text-xs"
            >
              {lang === "es" ? "El Problema" : "The Problem"}
            </span>
          </div>
          <p class="line-clamp-2 text-xs leading-relaxed text-foreground md:text-sm">
            {project.data.problem}
          </p>
        </div>
      )
    }

    {/* ─── Screenshot Preview Strip ─── */}
    {
      previewScreenshot && (
        <div class="overflow-hidden rounded-xl border border-border bg-secondary/50">
          <Image
            src={previewScreenshot}
            width={800}
            height={450}
            alt={`${project.data.title} dashboard overview`}
            class="w-full object-cover"
          />
        </div>
      )
    }

    {/* ─── CTA ─── */}
    <div class="flex">
      <a
        href={detailUrl}
        class="group/btn inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand px-6 py-2.5 text-sm font-semibold text-brand-foreground shadow-sm transition-[filter] duration-200 hover:brightness-90 md:w-auto md:px-8 md:py-3 md:text-base"
      >
        <span>{t("projects.cta")}</span>
        <Icon
          name="mdi:arrow-right"
          class="size-4 transition-transform duration-300 group-hover/btn:translate-x-0.5 md:size-5"
        />
      </a>
    </div>
  </div>
</div>
