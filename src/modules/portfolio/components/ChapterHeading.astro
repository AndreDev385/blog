---
/* Section heading — the page's axis (design-direction.md, 2026-10-22):
   mono label + display title, left-aligned. Refuses the centered header
   with the gradient underline bar. */

export type Chapter = {
  /** Mono section label, e.g. "services" */
  key: string;
  title: string;
  /** Retained for compatibility with existing callers */
  icon?: string;
  gradient?: string;
  borderColor?: string;
};

const { chapter, size = "md" } = Astro.props as {
  chapter: Chapter;
  size?: "md" | "lg";
};

const isLg = size === "lg";
---

<div>
  <p class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase">
    {chapter.key}
  </p>
  <h2
    class={`mt-2 font-bold text-foreground ${isLg ? "text-3xl tracking-tight md:text-4xl" : "text-xl md:text-2xl"}`}
  >
    {chapter.title}
  </h2>
</div>
