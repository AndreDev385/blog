---
import { Icon } from "astro-icon/components";

import type { Skill } from "@/lib/skillIconMap";
import SkillBadge from "@/components/SkillBadge.astro";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  company,
  location,
  startDate,
  endDate,
  description,
  skills,
  logo,
  link,
} = Astro.props;
---

<div
  class="group rounded-2xl border border-border bg-card shadow-sm transition-colors hover:border-brand/40"
>
  <div class="p-8">
    <div class="flex flex-col space-y-6">
      {/* Header Section */}
      <div class="space-y-3">
        <div class="flex gap-4">
          {
            logo ? (
              <Image
                src={logo}
                width={logo.width}
                height={logo.height}
                alt={`${company} logo`}
                class="size-14 rounded-full object-contain"
              />
            ) : (
              <div class="flex size-14 items-center justify-center rounded-full bg-secondary">
                <Icon name="mdi:briefcase" class="size-8 text-muted-foreground" />
              </div>
            )
          }

          <div>
            <div class="flex items-center gap-2">
              <h2
                class="text-2xl font-bold text-foreground transition-colors duration-300 group-hover:text-brand"
              >
                {company}
              </h2>
              {
                link && (
                  <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center rounded-md p-1.5 text-muted-foreground transition-colors duration-300 hover:text-brand"
                    title={`Visit ${company}`}
                    aria-label="Visit website"
                  >
                    <Icon name="mdi:open-in-new" class="size-5" />
                  </a>
                )
              }
            </div>
            <h3
              class="text-xl font-semibold text-muted-foreground transition-colors duration-300 group-hover:text-foreground"
            >
              {title}
            </h3>
          </div>
        </div>

        {/* Date and Location */}
        <div class="flex flex-wrap gap-4 text-muted-foreground">
          <div class="flex items-center gap-2">
            <Icon name="mdi:calendar-month" class="size-6 text-muted-foreground" />
            <span class="font-medium">{startDate} - {endDate}</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="mdi:location-on" class="size-6 text-muted-foreground" />
            <span class="font-medium">{location}</span>
          </div>
        </div>
      </div>

      {/* Achievements Section */}
      <div class="space-y-4">
        <h4 class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase">
          {t("experience.card.achievements")}
        </h4>
        <ul class="space-y-3">
          {
            description.map((item: string) => (
              <li class="flex items-start gap-3">
                <div class="mt-2 h-2 w-2 shrink-0 rounded-full bg-muted-foreground/50" />
                <span class="leading-relaxed text-foreground">
                  {item}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Tools Section */}
      <div class="space-y-4">
        <h4 class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase">
          {t("experience.card.tool")}
        </h4>
        <div class="flex flex-wrap gap-2">
          {
            skills.map(function displaySkill(skill: Skill) {
              return <SkillBadge skill={skill} />;
            })
          }
        </div>
      </div>
    </div>
  </div>
</div>
