---
import { Icon } from "astro-icon/components";

import ModeToggle from "@/components/ModeToggle.astro";
import ProcessPipeline from "./ProcessPipeline.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const WHATSAPP_URL = "https://wa.me/584241756082";
const LINKEDIN_URL = "https://www.linkedin.com/in/andr%C3%A9-izarra/";
---

<!-- Hero — claim on a real axis, the process runs on the stage beside it
     (design-direction.md, 2026-10-22: refuses the dead-center stack) -->
<section
  id="hero"
  class="relative flex min-h-screen items-center bg-background px-6 py-20 md:px-4"
>
  <div
    class="mx-auto grid w-full max-w-7xl items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16"
  >
    <!-- ─── Left: the claim ─── -->
    <div>
      <!-- Greeting — mono, the CRM's label language -->
      <p class="font-mono text-sm text-muted-foreground">
        {t("hero.greet")}{" "}
        <span class="font-medium text-foreground">André Izarra</span>
      </p>

      <!-- Main claim -->
      <h1
        class="mt-6 text-5xl leading-[1.05] font-bold text-balance md:text-6xl lg:text-7xl"
      >
        {t("hero.claim")}
      </h1>

      <!-- Sub -->
      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl"
      >
        {t("hero.sub")}
      </p>

      <!-- CTAs (one per mode — mode logic shows the matching one) -->
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <!-- Freelance CTA -->
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="contact-whatsapp"
          class="cta-freelance inline-flex items-center gap-2.5 rounded-full bg-brand px-7 py-3 text-sm font-semibold text-brand-foreground shadow-sm transition-[filter] duration-200 hover:brightness-90"
        >
          <Icon name="mdi:whatsapp" class="size-5" />
          <span>{t("hero.cta.freelance")}</span>
        </a>

        <!-- Employee CTA -->
        <a
          href={LINKEDIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="contact-linkedin"
          class="cta-employee inline-flex items-center gap-2.5 rounded-full border border-border px-7 py-3 text-sm font-semibold text-foreground transition-colors duration-200 hover:bg-secondary"
        >
          <Icon name="mdi:linkedin" class="size-5" />
          <span>{t("hero.cta.employee")}</span>
        </a>
      </div>

      <!-- Audience switch (drives sections + CTA below) -->
      <div class="mt-10">
        <ModeToggle />
      </div>
    </div>

    <!-- ─── Right: the signature — "How I Work" as a live pipeline ─── -->
    <div data-reveal>
      <ProcessPipeline />
    </div>
  </div>
</section>
