---
import { Icon } from "astro-icon/components";

type Props = {
  socials: Array<{
    icon: string;
    ariaLabel: string;
    href: string;
  }>;
  variant?: "hero" | "footer";
};

const { socials, variant = "hero" } = Astro.props;

const isFooter = variant === "footer";
---

{
  isFooter ? (
    <div class="flex items-center gap-4">
      {socials.map(function displaySocialIcon(info) {
        return (
          <a
            target="_blank"
            href={info.href}
            class="group/social flex size-10 items-center justify-center rounded-full border border-border bg-card shadow-sm transition-colors duration-300 hover:border-brand/40 hover:text-brand"
            aria-label={info.ariaLabel}
          >
            <Icon
              name={info.icon}
              class="size-5 text-muted-foreground transition-colors duration-300 group-hover/social:text-brand"
            />
          </a>
        );
      })}
    </div>
  ) : (
    <div class="mb-12 translate-y-8 transform animate-[fadeInUp_1s_ease-out_0.8s_forwards] opacity-0 transition-all duration-1000 ease-out">
      <div class="flex justify-center gap-6">
        {socials.map(function displaySocialIcon(info) {
          return (
            <a
              target="_blank"
              href={info.href}
              class="group/social rounded-full border border-border bg-card p-4 shadow-sm transition-colors duration-300 hover:border-brand/40 hover:text-brand"
              aria-label={info.ariaLabel}
            >
              <Icon
                name={info.icon}
                class="size-8 text-muted-foreground transition-colors duration-300 group-hover/social:text-brand"
              />
            </a>
          );
        })}
      </div>
    </div>
  )
}
