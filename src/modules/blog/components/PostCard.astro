---
import SkillBadge from "@/components/SkillBadge.astro";

import { skillIconMap } from "@/lib/skillIconMap";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import { formatDate } from "../utils/formatDate";

/* Listing card (design-direction.md, 2026-10-22): the CRM-panel idiom —
   border-border on bg-card, shadow-sm, hover is border feedback only
   (no glow, no lift). Hierarchy: mono "posted on" label, display-font
   title, muted description, neutral outline skill pills. The whole card
   stays clickable through the wrapping <a>; the image column keeps its
   photo behind a rounded-xl border. */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { post } = Astro.props;
const url = `/${post.id.split("/")[0]}/blog/${post.id.split("/")[1]}`;
---

<a href={url} class="group block">
  <article
    id={post.data.title}
    class="grid grid-cols-1 gap-6 rounded-2xl border border-border bg-card p-6 shadow-sm transition-colors duration-300 hover:border-brand/40 md:grid-cols-3 md:p-7"
  >
    <div class="flex min-w-0 flex-col md:col-span-2">
      {/* Mono metadata label */}
      <p
        class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase"
      >
        {t("posted.on")}
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date, lang)}</time
        >
      </p>

      {/* Display-font title */}
      <h2
        class="mt-3 text-2xl leading-tight font-bold tracking-tight text-foreground transition-colors group-hover:text-brand sm:text-3xl"
      >
        {post.data.title}
      </h2>

      <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
        {post.data.description}
      </p>

      {/* Neutral outline skill pills */}
      <div class="mt-auto flex flex-wrap items-center gap-2 pt-5">
        {
          post.data.tags
            .filter((tag: string) => tag in skillIconMap)
            .map((tag: string) => (
              <SkillBadge
                skill={skillIconMap[tag as keyof typeof skillIconMap]}
              />
            ))
        }
      </div>
    </div>

    {/* Image column */}
    <div
      class="relative hidden min-h-44 overflow-hidden rounded-xl border border-border md:col-span-1 md:block"
    >
      <img
        src={post.data.image}
        alt={`Featured image for "${post.data.title}"`}
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        loading="lazy"
      />
    </div>
  </article>
</a>
