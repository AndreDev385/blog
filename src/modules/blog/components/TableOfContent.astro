---
/* Table of contents (design-direction.md, 2026-10-22): the CRM-panel card
   idiom — border-border on bg-card, shadow-sm, mono label as its heading.
   Links are muted; green only as hover feedback on the interactive text.
   Depth indentation is kept as-is (scoped styles below). */

const { headings } = Astro.props;
---

<nav
  class="toc rounded-2xl border border-border bg-card p-5 shadow-sm"
  aria-labelledby="toc-heading"
>
  <h2
    id="toc-heading"
    class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase"
  >
    Table of Contents
  </h2>
  <ul class="mt-4 space-y-2.5">
    {
      headings.map((heading: any) => (
        <li class={`toc-item toc-item-${heading.depth}`}>
          <a
            href={`#${heading.slug}`}
            class="block text-sm leading-snug text-muted-foreground transition-colors hover:text-brand"
            title={heading.text}
          >
            {heading.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .toc-item {
    margin-left: 0rem;
  }
  .toc-item-2 {
    margin-left: 1rem;
  }
  .toc-item-3 {
    margin-left: 2rem;
  }
  .toc-item-4 {
    margin-left: 3rem;
  }
</style>
