---
import PostCard from "@/modules/blog/components/PostCard.astro";
import Layout from "@/layouts/Layout.astro";

import { collectTags } from "@/modules/blog/utils/collectTags";
import { getCollection } from "astro:content";
import type { Lang } from "@/i18n/ui";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

export const prerender = true;

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");
  blogPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  const tags: string[] = [];
  const langs: Lang[] = [];

  for (const post of blogPosts) {
    collectTags(tags, post.data.tags);
    const lang = post.id.split("/")[0];
    if (!langs.includes(lang as Lang)) {
      langs.push(lang as Lang);
    }
  }

  return [
    ...langs.flatMap((lang) => {
      return tags.map((tag) => {
        const posts = blogPosts.filter(
          (post) =>
            post.data.tags.includes(tag) && post.id.split("/")[0] === lang,
        );

        return {
          params: { tag, lang },
          props: {
            posts,
          },
        };
      });
    }),
    ...langs.map((lang) => {
      const posts = blogPosts.filter((p) => p.id.split("/")[0] === lang);
      return {
        params: { tag: lang === "es" ? "todos" : "all", lang },
        props: { posts },
      };
    }),
  ];
}

const { tag, lang } = Astro.params;
const blogPosts = await getCollection("blog");
const t = useTranslations(getLangFromUrl(Astro.url));

const tags: string[] = [lang === "es" ? "todos" : "all"];
for (const post of blogPosts) {
  collectTags(tags, post.data.tags);
}

const { posts } = Astro.props;

/* Same wording the page already ships in its <title>; the header now shows
   it in the ChapterHeading idiom (mono label + display heading, left-aligned). */
const pageTitle =
  tag === "all" || tag === "todos"
    ? t("tags.all")
    : `${t("tags.tag")}: ${tag}`;

const chipClass = (currTag: string) =>
  `inline-block rounded-full px-3 py-1 font-mono text-xs tracking-[0.08em] transition-colors ${
    tag === currTag
      ? "bg-brand-soft font-semibold text-brand"
      : "text-muted-foreground hover:text-brand"
  }`;
---

<Layout
  title={pageTitle}
  description={`Browse blog posts tagged with "${tag}" — André Izarra's blog about software development, TypeScript, DDD, and more.`}
>
  <div class="mx-auto mt-4 max-w-7xl px-6 md:px-4 lg:px-2">
    {/* Listing header — mono label + display heading, left-aligned */}
    <header class="mt-6 mb-6 md:mt-10 md:mb-8">
      <p
        class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase"
      >
        {t("header.blog")}
      </p>
      <h1
        class="mt-2 text-3xl font-bold tracking-tight text-foreground md:text-4xl"
      >
        {pageTitle}
      </h1>
    </header>

    {/* Tag chips — mobile / tablet */}
    <div
      class="flex flex-wrap gap-1 rounded-2xl border border-border bg-secondary/40 p-2 lg:hidden"
    >
      {
        tags.map((currTag) => (
          <a
            href={`/${lang}/tags/${currTag.toLowerCase()}`}
            class={chipClass(currTag)}
          >
            {currTag}
          </a>
        ))
      }
    </div>
  </div>

  {/* Post list + tag sidebar */}
  <div
    class="mx-auto mt-8 flex max-w-7xl flex-col gap-8 px-6 md:px-4 lg:flex-row lg:px-2"
  >
    <div class="lg:w-4/5">
      <ul class="flex flex-col justify-center space-y-6">
        {posts.map((post: any) => <PostCard post={post} />)}
      </ul>
    </div>
    <aside class="hidden flex-shrink-0 lg:block lg:w-1/5">
      <ul class="space-y-1.5">
        {
          tags.map((currTag) => (
            <li>
              <a
                href={`/${lang}/tags/${currTag.toLowerCase()}`}
                class={chipClass(currTag)}
              >
                {currTag}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Layout>
