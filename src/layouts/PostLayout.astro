---
import "@/styles/markdown.css";
import Layout from "@/layouts/Layout.astro";
import TableOfContent from "@/modules/blog/components/TableOfContent.astro";
import SkillBadge from "@/components/SkillBadge.astro";

import { skillIconMap } from "@/lib/skillIconMap";
import { Author } from "@/components/Author";

import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { formatDate } from "@/modules/blog/utils/formatDate";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { post, headings } = Astro.props;
---

<Layout title={post.data.title} description={post.data.description}>
  <!-- Structured Data: BlogPosting -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      author: {
        "@type": "Person",
        name: "André Izarra",
      },
      image: post.data.image,
      keywords: post.data.tags?.join(", ") || "",
    })}
  />

  <div
    class="mx-auto mt-4 flex max-w-6xl flex-col gap-8 px-6 md:px-4 lg:flex-row lg:justify-center lg:px-2"
  >
    <div class="max-w-[68ch] min-w-0 flex-1">
      <article>
        <header class="relative mb-8">
          {/* Back link — mono label, green only as hover feedback */}
          <a
            href={`/${lang}/tags/${lang === "es" ? "todos" : "all"}`}
            class="inline-flex items-center gap-1.5 font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase transition-colors hover:text-brand"
          >
            &larr; {t("header.blog")}
          </a>
          <h1
            class="mt-4 mb-2 text-4xl leading-tight font-bold tracking-tight text-balance text-foreground lg:text-5xl"
          >
            {post.data.title}
          </h1>
          <Author
            postedString={`${t("posted.on")} ${formatDate(post.data.date, lang)}`}
          />
          {
            post.data.tags && (
              <div class="mt-4 flex flex-wrap items-center gap-2">
                {post.data.tags
                  .filter((tag: string) => tag in skillIconMap)
                  .map((tag: string) => (
                    <a
                      href={`/${lang}/tags/${tag.toLowerCase()}`}
                      class="rounded-full transition-colors hover:bg-brand-soft"
                    >
                      <SkillBadge
                        skill={skillIconMap[tag as keyof typeof skillIconMap]}
                      />
                    </a>
                  ))}
              </div>
            )
          }
        </header>
        <div class="prose prose-lg relative max-w-none">
          <slot />
        </div>
      </article>
    </div>
    <aside class="hidden w-64 flex-shrink-0 lg:block">
      <div class="sticky top-8">
        <TableOfContent headings={headings} />
      </div>
    </aside>
  </div>
</Layout>
