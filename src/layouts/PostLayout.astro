---
import "@/styles/markdown.css";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import TableOfContent from "@/modules/blog/components/TableOfContent.astro";
import SkillBadge from "@/components/SkillBadge.astro";

import { skillIconMap } from "@/lib/skillIconMap";
import { Author } from "@/components/Author";

import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { formatDate } from "@/modules/blog/utils/formatDate";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { post, headings } = Astro.props;

// Reading time — ~200 words per minute
const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// Previous (older) / next (newer) in the same language
const siblings = (await getCollection("blog"))
  .filter((p) => p.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const index = siblings.findIndex((p) => p.id === post.id);
const olderPost = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : null;
const newerPost = index > 0 ? siblings[index - 1] : null;
const postHref = (p: (typeof siblings)[number]) => `/${lang}/blog/${p.id.split("/")[1]}`;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
>
  <!-- Structured Data: BlogPosting -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      author: {
        "@type": "Person",
        name: "André Izarra",
      },
      image: post.data.image,
      keywords: post.data.tags?.join(", ") || "",
    })}
  />

  <div
    class="mx-auto mt-4 flex max-w-6xl flex-col gap-8 px-6 md:px-4 lg:flex-row lg:justify-center lg:px-2"
  >
    <div class="max-w-[68ch] min-w-0 flex-1">
      <article>
        <header class="relative mb-8">
          {/* Back link — mono label, green only as hover feedback */}
          <a
            href={`/${lang}/tags/${lang === "es" ? "todos" : "all"}`}
            class="inline-flex items-center gap-1.5 font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase transition-colors hover:text-brand"
          >
            &larr; {t("header.blog")}
          </a>
          <h1
            class="mt-4 mb-2 text-4xl leading-tight font-bold tracking-tight text-balance text-foreground lg:text-5xl"
          >
            {post.data.title}
          </h1>
          <Author
            postedString={`${t("posted.on")} ${formatDate(post.data.date, lang)} · ${readingMinutes} ${t("post.min_read")}`}
          />
          {
            post.data.tags && (
              <div class="mt-4 flex flex-wrap items-center gap-2">
                {post.data.tags
                  .filter((tag: string) => tag in skillIconMap)
                  .map((tag: string) => (
                    <a
                      href={`/${lang}/tags/${tag.toLowerCase()}`}
                      class="rounded-full transition-colors hover:bg-brand-soft"
                    >
                      <SkillBadge
                        skill={skillIconMap[tag as keyof typeof skillIconMap]}
                      />
                    </a>
                  ))}
              </div>
            )
          }
        </header>
        <div class="prose prose-lg relative max-w-none">
          <slot />
        </div>
      </article>

      {/* Reading flow — previous (older) / next (newer) */}
      {
        (olderPost || newerPost) && (
          <nav
            class="mt-12 grid gap-4 border-t border-border pt-8 sm:grid-cols-2"
            aria-label={t("header.blog")}
          >
            {olderPost && (
              <a
                href={postHref(olderPost)}
                class="group rounded-2xl border border-border bg-card p-5 shadow-sm transition-colors hover:border-brand/40"
              >
                <p class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase">
                  &larr; {t("post.prev")}
                </p>
                <p class="mt-2 font-display text-lg font-semibold text-balance group-hover:text-brand">
                  {olderPost.data.title}
                </p>
              </a>
            )}
            {newerPost && (
              <a
                href={postHref(newerPost)}
                class={`group rounded-2xl border border-border bg-card p-5 shadow-sm transition-colors hover:border-brand/40 ${olderPost ? "sm:text-right" : "sm:col-start-2 sm:text-right"}`}
              >
                <p class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase">
                  {t("post.next")} &rarr;
                </p>
                <p class="mt-2 font-display text-lg font-semibold text-balance group-hover:text-brand">
                  {newerPost.data.title}
                </p>
              </a>
            )}
          </nav>
        )
      }
    </div>
    <aside class="hidden w-64 flex-shrink-0 lg:block">
      <div class="sticky top-8">
        <TableOfContent headings={headings} />
      </div>
    </aside>
  </div>
</Layout>
