---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const isSpanish = lang === "es";
const path = Astro.url.pathname;

const navItems = [
  {
    href: `/${lang}`,
    text: t("header.home"),
    active: path === `/${lang}` || path === `/${lang}/`,
  },
  {
    href: `/${lang}/tags/${lang === "es" ? "todos" : "all"}`,
    text: t("header.blog"),
    active:
      path.startsWith(`/${lang}/tags`) || path.startsWith(`/${lang}/blog`),
  },
];

/** Same page in the other language (language-aware links, blog rule #1) */
function counterpart(target: "en" | "es"): string {
  const parts = path.split("/").filter(Boolean);
  if (parts[0] !== "en" && parts[0] !== "es") return `/${target}`;
  parts[0] = target;
  if (parts[1] === "tags" && parts[2]) {
    parts[2] = target === "es" ? "todos" : "all";
  }
  return `/${parts.join("/")}`;
}

const hrefEn = counterpart("en");
const hrefEs = counterpart("es");
---

<!-- Sticky nav — the CRM's lockup language: ink monogram tile, display name,
     mono labels, segmented language control (design-direction.md 2026-10-22) -->
<header
  class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur-md"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 md:px-4 lg:px-2"
  >
    <a href={`/${lang}`} class="group flex items-center gap-3">
      <span
        class="flex size-9 items-center justify-center rounded-xl bg-primary font-display text-sm font-bold text-primary-foreground"
      >
        AI
      </span>
      <span class="font-display text-xl font-bold">André Izarra</span>
    </a>

    <!-- Desktop -->
    <nav class="hidden items-center gap-2 md:flex">
      <ul class="flex items-center gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class={`inline-flex items-center rounded-full px-4 py-2 text-sm font-medium transition-colors ${
                  item.active
                    ? "text-foreground"
                    : "text-muted-foreground hover:text-foreground"
                }`}
              >
                {item.text}
                {item.active && (
                  <span class="ml-2 h-1.5 w-1.5 rounded-full bg-brand" />
                )}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Language — segmented control, keeps you on the same page -->
      <div
        class="ml-2 flex items-center gap-1 rounded-full border border-border bg-card p-1"
        role="group"
        aria-label={isSpanish ? "Idioma" : "Language"}
      >
        <a
          href={hrefEn}
          lang="en"
          aria-current={!isSpanish ? "true" : undefined}
          class={`rounded-full px-3 py-1 text-xs font-semibold transition-colors ${
            !isSpanish
              ? "bg-primary text-primary-foreground"
              : "text-muted-foreground hover:text-foreground"
          }`}
        >
          EN
        </a>
        <a
          href={hrefEs}
          lang="es"
          aria-current={isSpanish ? "true" : undefined}
          class={`rounded-full px-3 py-1 text-xs font-semibold transition-colors ${
            isSpanish
              ? "bg-primary text-primary-foreground"
              : "text-muted-foreground hover:text-foreground"
          }`}
        >
          ES
        </a>
      </div>
    </nav>

    <!-- Mobile trigger -->
    <button
      id="menuButton"
      class="rounded-full border border-border p-2 text-foreground transition-colors hover:bg-secondary md:hidden"
      aria-label={isSpanish ? "Abrir menú" : "Open menu"}
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        class="h-5 w-5"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile menu -->
<div
  id="mobileMenu"
  class="fixed inset-0 z-50 hidden bg-background md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label={isSpanish ? "Menú" : "Menu"}
>
  <div class="flex h-full flex-col p-6">
    <div class="flex items-center justify-between">
      <p
        class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase"
      >
        {isSpanish ? "Menú" : "Menu"}
      </p>
      <button
        id="closeMenuButton"
        class="rounded-full border border-border p-2 text-foreground transition-colors hover:bg-secondary"
        aria-label={isSpanish ? "Cerrar menú" : "Close menu"}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <ul class="mt-10 flex flex-col gap-2">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.active ? "page" : undefined}
              class="font-display flex items-center justify-between rounded-2xl border border-transparent px-4 py-3 text-2xl font-bold transition-colors hover:border-border hover:bg-secondary"
            >
              {item.text}
              {item.active && <span class="h-2 w-2 rounded-full bg-brand" />}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-auto border-t border-border pt-5">
      <p
        class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase"
      >
        {isSpanish ? "Idioma" : "Language"}
      </p>
      <div
        class="mt-3 flex items-center gap-2"
        role="group"
        aria-label={isSpanish ? "Idioma" : "Language"}
      >
        <a
          href={hrefEn}
          lang="en"
          class={`flex-1 rounded-full px-4 py-2.5 text-center text-sm font-semibold transition-colors ${
            !isSpanish
              ? "bg-primary text-primary-foreground"
              : "border border-border text-muted-foreground"
          }`}
        >
          English
        </a>
        <a
          href={hrefEs}
          lang="es"
          class={`flex-1 rounded-full px-4 py-2.5 text-center text-sm font-semibold transition-colors ${
            isSpanish
              ? "bg-primary text-primary-foreground"
              : "border border-border text-muted-foreground"
          }`}
        >
          Español
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const menuButton = document.getElementById("menuButton");
  const closeMenuButton = document.getElementById("closeMenuButton");
  const mobileMenu = document.getElementById("mobileMenu");

  function openMenu() {
    mobileMenu?.classList.remove("hidden");
    menuButton?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    mobileMenu?.classList.add("hidden");
    menuButton?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  menuButton?.addEventListener("click", openMenu);
  closeMenuButton?.addEventListener("click", closeMenu);
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>
