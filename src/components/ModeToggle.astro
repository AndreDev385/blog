---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="flex flex-col items-start gap-3" data-mode-toggle>
  <!-- Label -->
  <p
    class="text-[11px] font-medium tracking-[0.12em] text-muted-foreground uppercase"
  >
    {t("mode.label")}
  </p>

  <!-- Two option cards -->
  <div class="flex gap-3">
    <button
      class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-border px-4 py-2.5 text-sm font-semibold transition-all duration-200 select-none"
      data-mode="freelance"
      aria-checked="true"
    >
      <Icon name="mdi:briefcase-outline" />
      <span>{t("mode.freelance")}</span>
    </button>

    <button
      class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-border px-4 py-2.5 text-sm font-semibold transition-all duration-200 select-none"
      data-mode="employee"
      aria-checked="false"
    >
      <Icon name="mdi:account-tie-outline" />
      <span>{t("mode.employee")}</span>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var container = document.querySelector("[data-mode-toggle]");
    if (!container) return;
    var cards = container.querySelectorAll("[data-mode]");
    var html = document.documentElement;
    var KEY = "portfolio-mode";

    /* Ink-on-white states (design-direction.md, 2026-10-22): no per-mode
       gradients or colored glows. Active = ink fill with white text, a
       matching border and one subtle shadow. Inactive = white card with
       muted ink text and a light border. */
    var COLORS = {
      active: {
        bg: "#161A1E",
        text: "#ffffff",
        border: "#161A1E",
        shadow: "0 1px 2px 0 rgba(22, 26, 30, 0.24)",
      },
      inactive: {
        bg: "#ffffff",
        text: "#5A6169",
        border: "#E2E5E9",
        shadow: "none",
      },
      inactiveTextHover: "#161A1E",
    };

    function setCardStyle(card, bg, text, border, shadow) {
      card.style.background = bg;
      card.style.color = text;
      card.style.borderColor = border;
      card.style.boxShadow = shadow;
    }

    function applyCardState(card, active) {
      var s = active ? COLORS.active : COLORS.inactive;
      setCardStyle(card, s.bg, s.text, s.border, s.shadow);
    }

    function setCardHover(card) {
      var cur = card.getAttribute("aria-checked") === "true";
      if (!cur) {
        card.style.color = COLORS.inactiveTextHover;
      }
    }

    function setCardLeave(card) {
      applyCardState(card, card.getAttribute("aria-checked") === "true");
    }

    function activate(mode) {
      cards.forEach(function (c) {
        var on = c.getAttribute("data-mode") === mode;
        c.setAttribute("aria-checked", on ? "true" : "false");
        applyCardState(c, on);
      });

      if (mode) {
        html.setAttribute("data-active-mode", mode);
        try {
          localStorage.setItem(KEY, mode);
        } catch (e) {}
      } else {
        html.removeAttribute("data-active-mode");
        try {
          localStorage.removeItem(KEY);
        } catch (e) {}
      }
    }

    // Init
    var saved;
    try {
      saved = localStorage.getItem(KEY);
    } catch (e) {}
    activate(
      saved === "freelance" || saved === "employee" ? saved : "freelance",
    );

    // Hover
    cards.forEach(function (c) {
      c.addEventListener("mouseenter", function () {
        setCardHover(c);
      });
      c.addEventListener("mouseleave", function () {
        setCardLeave(c);
      });
    });

    // Clicks
    cards.forEach(function (c) {
      c.addEventListener("click", function () {
        var mode = c.getAttribute("data-mode");
        var cur = html.getAttribute("data-active-mode");
        activate(cur === mode ? null : mode);
      });
    });
  })();
</script>
